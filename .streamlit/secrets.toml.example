# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored -- never commit real secrets.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-server-only-service-role-key"

# Password recovery: verified Brevo sender and a restricted transactional-email key.
BREVO_API_KEY = "your-brevo-api-key"
BREVO_SENDER_EMAIL = "wegopub@outlook.com"
BREVO_SENDER_NAME = "WeGoPub"
